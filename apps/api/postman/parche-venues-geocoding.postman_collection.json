          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register/manager",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Pérez\",\n  \"email\": \"{{emailB}}\",\n  \"password\": \"{{password}}\",\n  \"business\": {\n    \"name\": \"Café Parche B\",\n    \"type\": \"cafe\"\n  }\n}"
            }
          }
        },
        {
