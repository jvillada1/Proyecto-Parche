              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200))",
                  "const ids = pm.response.json().data.venues.map((venue) => venue.id)",
                  "pm.test('activos primero', () => pm.expect(ids).to.eql([pm.collectionVariables.get('venueId2'), pm.collectionVariables.get('venueId')]))"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/me/venues"
          }
        },
        {
          "name": "12 - GET ?active=si → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400))",
                  "pm.test('código VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'))",
                  "const paths = pm.response.json().error.details.map((detail) => detail.path)",
                  "pm.test('marca los campos query.active', () => pm.expect(paths).to.include.members([\"query.active\"]))"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/me/venues?active=si"
          }
        },
