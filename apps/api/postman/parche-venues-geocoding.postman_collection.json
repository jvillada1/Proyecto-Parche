                  "const inArea = (p) => p.lat >= 6.05 && p.lat <= 6.5 && p.lng >= -75.75 && p.lng <= -75.3",
                  "pm.test('ningún resultado fuera del área de servicio', () => pm.response.json().data.results.forEach((place) => pm.expect(inArea(place)).to.eql(true)))"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
