{
  "info": {
    "name": "Parche - Lugares (desactivar) y geocodificación",
    "description": "Ejecutar en orden con el Collection Runner. Requiere la API en {{baseUrl}} (pnpm db:up && pnpm dev) y conexión a internet para las peticiones marcadas como Nominatim real. Cada ejecución registra 2 gestores nuevos: el límite de registro es 10 por hora por IP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "password",
      "value": "clave1234"
    },
    {
      "key": "emailA",
      "value": ""
    },
    {
      "key": "emailB",
      "value": ""
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "venueId",
      "value": ""
    },
    {
      "key": "venueId2",
      "value": ""
    },
    {
      "key": "venueIdB",
      "value": ""
    },
    {
      "key": "searchResults",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Preparación",
      "item": [
        {
          "name": "01 - Registrar gestor A (guarda tokenA)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.collectionVariables.set('emailA', `emailA.${Date.now()}@parche.test`)"]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201))",
                  "pm.collectionVariables.set('tokenA', pm.response.json().data.accessToken)"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register/manager",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Pérez\",\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\",\n  \"business\": {\n    \"name\": \"Café Parche A\",\n    \"type\": \"cafe\"\n  }\n}"
            }
          }
        },
        {
          "name": "02 - Registrar gestor B (guarda tokenB)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.collectionVariables.set('emailB', `emailB.${Date.now()}@parche.test`)"]
