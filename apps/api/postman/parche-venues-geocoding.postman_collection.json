          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200))",
                  "pm.test('isActive = false persistido', () => pm.expect(pm.response.json().data.venue.isActive).to.eql(false))"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/me/venues/{{venueId}}"
          }
        },
        {
          "name": "09 - GET ?active=true (lugares para crear eventos) no ofrece el inactivo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200))",
                  "const ids = pm.response.json().data.venues.map((venue) => venue.id)",
                  "pm.test('no incluye la sede desactivada', () => pm.expect(ids).to.not.include(pm.collectionVariables.get('venueId')))",
                  "pm.test('incluye la sede activa', () => pm.expect(ids).to.include(pm.collectionVariables.get('venueId2')))",
                  "pm.test('todos activos', () => pm.response.json().data.venues.forEach((venue) => pm.expect(venue.isActive).to.eql(true)))"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/me/venues?active=true"
          }
        },
        {
          "name": "10 - GET ?active=false → solo inactivos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200))",
                  "const venues = pm.response.json().data.venues",
                  "pm.test('solo la sede desactivada', () => pm.expect(venues.map((venue) => venue.id)).to.eql([pm.collectionVariables.get('venueId')]))"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/me/venues?active=false"
          }
        },
        {
          "name": "11 - GET sin filtro → todos, activos primero",
