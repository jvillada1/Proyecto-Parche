              }
            ],
            "url": "{{baseUrl}}/geocoding/search?q=ab"
          }
        },
        {
          "name": "22 - search dirección en Medellín → 200 sugerencias (Nominatim real)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200))",
                  "const inArea = (p) => p.lat >= 6.05 && p.lat <= 6.5 && p.lng >= -75.75 && p.lng <= -75.3",
                  "const results = pm.response.json().data.results",
                  "pm.test('máximo 5 sugerencias', () => pm.expect(results.length).to.be.within(0, 5))",
                  "pm.test('todas dentro del área de servicio', () => results.forEach((place) => pm.expect(inArea(place), place.displayName).to.eql(true)))",
                  "pm.test('cada sugerencia trae displayName, lat, lng, neighborhood y city', () => results.forEach((place) => {",
                  "  pm.expect(place).to.have.all.keys('displayName', 'lat', 'lng', 'neighborhood', 'city')",
                  "  pm.expect(place.lat).to.be.a('number')",
                  "  pm.expect(place.lng).to.be.a('number')",
                  "}))",
                  "if (results.length === 0) console.warn('Nominatim no devolvió sugerencias para esta dirección')",
                  "pm.collectionVariables.set('searchResults', JSON.stringify(results))"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/geocoding/search?q=Carrera 70 Laureles Medellín"
          }
        },
        {
          "name": "23 - search el mismo texto con otras mayúsculas/espacios → responde desde caché",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200))",
                  "pm.test('mismas sugerencias que la búsqueda anterior', () => pm.expect(pm.response.json().data.results).to.eql(JSON.parse(pm.collectionVariables.get('searchResults'))))",
                  "pm.test('rápida porque no va a Nominatim (< 150 ms)', () => pm.expect(pm.response.responseTime).to.be.below(150))"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/geocoding/search?q=  CARRERA 70 LAURELES MEDELLÍN  "
          }
        },
