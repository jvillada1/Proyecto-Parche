            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/me/venues",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sede Laureles\",\n  \"address\": \"Cra. 70 #44-35\",\n  \"neighborhood\": \"Laureles\",\n  \"comuna\": \"11\",\n  \"location\": {\n    \"lat\": 6.2447,\n    \"lng\": -75.5906\n  }\n}"
