    {
      "name": "POST /me/venues/:id/deactivate",
      "item": [
        {
          "name": "06 - Desactivar Sede Laureles → 200 isActive false",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200))",
                  "const venue = pm.response.json().data.venue",
                  "pm.test('isActive = false', () => pm.expect(venue.isActive).to.eql(false))",
                  "pm.test('es el lugar pedido', () => pm.expect(venue.id).to.eql(pm.collectionVariables.get('venueId')))"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/me/venues/{{venueId}}/deactivate"
